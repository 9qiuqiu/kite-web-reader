{
  "name": "kite-web-reader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pay-per-request article extraction for AI agents on Kite x402",
  "license": "Apache-2.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "demo": "tsx scripts/demo.ts"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@x402/core": "^2.25.0",
    "@x402/evm": "^2.25.0",
    "@x402/express": "^2.25.0",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "ipaddr.js": "^2.2.0",
    "jsdom": "^26.1.0",
    "turndown": "^7.2.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.3.0",
    "@types/turndown": "^5.0.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
